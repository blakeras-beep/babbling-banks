# Babbling Banks environment variables
# Copy this file to .env and fill in your values. Never commit .env.

# --- Supabase (optional) ---
# Needed for accounts and synced favorites. Without these the app still works:
# search runs entirely in the browser and favorites are stored on the device.
# Find both values in Supabase: Project Settings -> API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Anthropic (optional, catalog generation only) ---
# Only used by `npm run generate-catalog`. Never exposed to the browser.
ANTHROPIC_API_KEY=your-api-key
# Only for user-level keys (sk-ant-usr-…), which are not tied to a workspace:
# the workspace id from console.anthropic.com -> Settings -> Workspaces.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# --- TMDB (optional, episode thumbnails only) ---
# Only used by `npm run fetch-episode-images`, which writes
# src/data/episode-images.json. Never exposed to the browser. Get a free key at
# https://www.themoviedb.org/settings/api and set one of the two:
TMDB_API_KEY=your-v3-api-key
# TMDB_READ_TOKEN=your-v4-read-access-token
